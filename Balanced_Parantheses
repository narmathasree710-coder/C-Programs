#include <stdio.h>
int valid(char *s)
{
    char stack[50];
    int top=-1;
    for(int i=0;s[i]!='\0';i++)
    {
        char ch=s[i];
        if(ch=='(' || ch=='{' || ch=='[')
        {
            stack[++top]=ch;
        }
        else
        {
            if(top==-1){
                return 0;}
            char open=stack[top--];
            if((ch==')' && open!='(') || 
               (ch=='}' && open!='{') || 
               (ch==']' && open!='[')){
                return 0;}
        }
    }
    return top==-1;
}
int main()
{
    char s[50];
    printf("Enter the expression: ");
    scanf("%s",s);
    if (valid(s))
        printf("Valid parentheses\n");
    else
        printf("Invalid parentheses\n");
    return 0;
}
