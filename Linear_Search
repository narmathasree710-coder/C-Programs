#include <stdio.h>

int main() {
    int n, target, i;
    printf("Enter the number of elements: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter the array elements:\n");
    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    printf("Enter the target value: ");
    scanf("%d", &target);
    for(i = 0; i < n; i++) {
        if(arr[i] == target) {
            printf("Target found at position %d\n", i + 1);
            return 0;
        }
    }
    printf("Target not found in the array\n");
    return 0;
}
